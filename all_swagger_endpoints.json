      "path": "/api/v1/admin/seller-verifications",
      "summary": "Get seller verifications with filters (status, ekycStatus, riskStatus, reasonCode) and pagination",
      "tags": [
        "Admin - Seller Verifications"
      ],
      "parameters": [
        {
          "name": "status",
          "in": "query",
