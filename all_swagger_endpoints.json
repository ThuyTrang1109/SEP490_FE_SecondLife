  ],
  "components": {
    "schemas": {
      "SellerVerificationRequest": {
        "type": "object",
        "properties": {
          "verificationType": {
            "type": "string",
            "enum": [
              "CITIZEN_ID",
              "PASSPORT",
              "BUSINESS_LICENSE"
            ]
          },
          "documentNumber": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "documentFrontUrl": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 0
          },
          "documentBackUrl": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 0
          },
          "selfieUrl": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 0
          }
        },
        "required": [
          "documentBackUrl",
          "documentFrontUrl",
          "documentNumber",
          "verificationType"
        ]
      },
      "ApiResponseSellerVerificationResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/SellerVerificationResponse"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SellerVerificationResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "userEmail": {
            "type": "string"
          },
          "userFullName": {
            "type": "string"
          },
          "verificationType": {
            "type": "string",
            "enum": [
              "CITIZEN_ID",
              "PASSPORT",
              "BUSINESS_LICENSE"
            ]
          },
          "documentNumber": {
            "type": "string"
          },
          "documentFrontUrl": {
            "type": "string"
          },
          "documentBackUrl": {
            "type": "string"
          },
          "selfieUrl": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "SUBMITTED",
              "EKYC_PENDING",
              "RESUBMIT_REQUIRED",
              "NEEDS_REVIEW",
              "APPROVED",
              "REJECTED"
            ]
          },
          "ekycStatus": {
            "type": "string",
            "enum": [
              "NOT_STARTED",
              "PENDING",
              "PASSED",
              "FAILED",
              "UNCERTAIN",
              "PROVIDER_ERROR"
            ]
          },
          "riskStatus": {
            "type": "string",
            "enum": [
              "NOT_EVALUATED",
              "CLEAR",
              "REVIEW",
              "BLOCK"
            ]
          },
          "reviewSource": {
            "type": "string",
            "enum": [
              "SYSTEM",
              "ADMIN"
            ]
          },
          "reasonCode": {
            "type": "string",
            "enum": [
              "DOCUMENT_EXPIRED",
              "DOCUMENT_SUSPECTED_FAKE",
              "FACE_MISMATCH",
              "LIVENESS_FAILED",
              "UNSUPPORTED_DOCUMENT",
              "CONFIRMED_IDENTITY_MISMATCH",
              "IMAGE_TOO_BLURRY",
              "IMAGE_GLARE",
              "DOCUMENT_NOT_FULLY_VISIBLE",
              "SELFIE_QUALITY_LOW",
              "OCR_LOW_CONFIDENCE_DUE_TO_IMAGE",
              "OCR_LOW_CONFIDENCE",
              "FACE_MATCH_BORDERLINE",
              "DOCUMENT_DATA_INCONSISTENCY",
              "OCR_INCONSISTENT",
              "PROVIDER_MANUAL_REVIEW_REQUIRED",
              "DUPLICATE_IDENTITY_EXCEPTION",
              "AMBIGUOUS_IDENTITY_RESULT",
              "PROVIDER_TIMEOUT",
              "PROVIDER_UNAVAILABLE",
              "DUPLICATE_IDENTITY",
              "ACCOUNT_LOCKED",
              "ACCOUNT_DISABLED",
              "PERMANENT_SELLER_BAN",
              "REPEATED_EKYC_FAILURES",
              "RISK_FLAGGED",
              "MANUAL_REVIEW_REQUIRED",
              "NONE"
            ]
          },
          "resubmissionCount": {
            "type": "integer",
            "format": "int32"
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time"
          },
          "reviewedAt": {
            "type": "string",
            "format": "date-time"
          },
          "reviewedBy": {
            "type": "string",
            "format": "uuid"
          },
          "rejectionReason": {
            "type": "string"
          }
        }
      },
      "SellerVerificationResubmitRequest": {
        "type": "object",
        "properties": {
          "documentFrontUrl": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 0
          },
          "documentBackUrl": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 0
          },
          "selfieUrl": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 0
          }
        },
        "required": [
          "documentBackUrl",
          "documentFrontUrl"
        ]
      },
      "ChangePasswordRequest": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "minLength": 1
          },
          "newPassword": {
            "type": "string",
            "minLength": 1
          },
          "confirmPassword": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "confirmPassword",
          "currentPassword",
          "newPassword"
        ]
      },
      "ApiResponseVoid": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "data": {},
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "VerifyEmailRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "Account email address",
            "example": "buyer@example.com",
            "minLength": 1
          },
          "otp": {
            "type": "string",
            "description": "6-digit OTP received via email",
            "example": "123456",
            "minLength": 1,
            "pattern": "^[0-9]{6}$"
          }
        },
        "required": [
          "email",
          "otp"
        ]
      },
      "ResetPasswordRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "Account email address",
            "example": "buyer@example.com",
            "minLength": 1
          },
          "otp": {
            "type": "string",
            "description": "6-digit OTP received via email",
            "example": "123456",
            "minLength": 1,
            "pattern": "^[0-9]{6}$"
          },
          "newPassword": {
            "type": "string",
            "description": "New password (min 8 chars, uppercase, lowercase, digit, special char)",
            "example": "NewSecretPass@123",
            "minLength": 1
          },
          "confirmPassword": {
            "type": "string",
            "description": "Confirm new password",
            "example": "NewSecretPass@123",
            "minLength": 1
          }
        },
        "required": [
          "confirmPassword",
          "email",
          "newPassword",
          "otp"
        ]
      },
      "ResendVerificationRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 1
          }
        },
        "required": [
          "email"
        ]
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "minLength": 1
          },
          "fullName": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2
          },
          "phone": {
            "type": "string",
            "pattern": "^[+0-9\\-\\s()]{7,20}$"
          }
        },
        "required": [
          "email",
          "fullName",
          "password"
        ]
      },
      "ApiResponseAuthResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/AuthResponse"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "accessTokenExpiresInMs": {
            "type": "integer",
            "format": "int64"
          },
          "user": {
            "$ref": "#/components/schemas/UserSummaryResponse"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      },
      "UserSummaryResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string"
          },
          "accountStatus": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "LOCKED",
              "DISABLED",
              "PENDING_VERIFICATION"
            ]
          },
          "emailVerified": {
            "type": "boolean"
          }
        }
      },
      "RefreshTokenRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "ApiResponseTokenResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/TokenResponse"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "accessTokenExpiresInMs": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "GoogleLoginRequest": {
        "type": "object",
        "properties": {
          "idToken": {
            "type": "string",
            "description": "ID token obtained from Google Sign-In on client application",
            "example": "eyJhbGciOiJSUzI1NiIsImtpZCI6...",
            "minLength": 1
          }
        },
        "required": [
          "idToken"
        ]
      },
      "ForgotPasswordRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 1
          }
        },
        "required": [
          "email"
        ]
      },
      "SellerVerificationReviewRequest": {
        "type": "object",
        "properties": {
          "rejectionReason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 0
          }
        },
        "required": [
          "rejectionReason"
        ]
      },
      "CreateInspectionCenterRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "minLength": 1
          },
          "fullName": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2
          },
          "phone": {
            "type": "string",
            "pattern": "^[+0-9\\-\\s()]{7,20}$"
          }
        },
        "required": [
          "email",
          "fullName",
          "password"
        ]
      },
      "ApiResponseUserSummaryResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/UserSummaryResponse"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UpdateProfileRequest": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2
          },
          "phone": {
            "type": "string",
            "pattern": "^[+0-9\\-\\s()]{7,20}$"
          },
          "avatarUrl": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 0
          }
        }
      },
      "ApiResponseUserProfileResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/UserProfileResponse"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UserProfileResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string"
          },
          "accountStatus": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "LOCKED",
              "DISABLED",
              "PENDING_VERIFICATION"
            ]
          },
          "emailVerified": {
            "type": "boolean"
          },
          "roles": {
